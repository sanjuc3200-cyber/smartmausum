# ==============================================================================
# MAUSAM INSIGHT — LIVE WEATHER API CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy this file to .env and insert your free API key(s) below.
# ==============================================================================

# Option 1: OpenWeatherMap (Recommended)
# - Sign up (free): https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=

# Option 2: WeatherAPI.com
# - Sign up (free): https://www.weatherapi.com/
VITE_WEATHERAPI_KEY=

# Option 3: CARTO Basemaps API
# - Sign up (free, 5M tiles/month): https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=

# Application Name
VITE_APP_NAME="Mausam Insight"
VITE_ENV="development"
